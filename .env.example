# Copy to .env and fill in. Every value here is validated at API boot
# (see apps/api/src/config/env.schema.ts) — the process refuses to start
# with a missing/malformed value instead of failing weirdly at runtime.

# --- API ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:4200,http://localhost:4300

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql://luxeretail:luxeretail@localhost:5432/luxeretail

# --- Redis (BullMQ background jobs) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Stripe (test/sandbox mode — get these from your Stripe test dashboard) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Object storage (MinIO locally; swap for S3/R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=luxeretail
S3_SECRET_ACCESS_KEY=luxeretail123
S3_PUBLIC_URL=http://localhost:9000/product-images
S3_FORCE_PATH_STYLE=true

# --- Email (Mailhog locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=orders@luxeretail.dev

# --- Frontend apps (Vite — must be prefixed VITE_) ---
VITE_API_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Mobile (Expo — must be prefixed EXPO_PUBLIC_) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
